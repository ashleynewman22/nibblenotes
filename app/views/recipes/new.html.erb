<div class="recipe-new-page">
  <div class="new-recipe-heading justify-content-center">
  <!--<div class="container-heading text-center mb-3"-->
    <h2>Add Your Recipe</h2>
  </div>
  <!--</div>-->
  <div class="container recipe-form">
    <div class="row justify-content-center">
      <div class="col-md-10">
        <div class="recipe-info p-4">
        <%= simple_form_for(@recipe, html: { class: 'form-horizontal' }) do |f| %>

        <div class="new-recipe-labels">
        <div class="mb-2">
          <%= f.input :title, label_html: { class: 'form-label small-text' }, input_html: { class: 'form-control recipe-custom-textbox' } %>
        </div>

        <div class="mb-2">
          <%= f.input :ingredients, as: :text, label_html: { class: 'form-label small-text' }, input_html: { rows: 3, class: 'form-control recipe-custom-textbox' } %>
        </div>

        <div class="mb-2">
          <%= f.input :method, as: :text, label_html: { class: 'form-label small-text' }, input_html: { rows: 4, class: 'form-control recipe-custom-textbox' } %>
        </div>

        <div class="mb-2">
          <%= f.input :photo, as: :file, label_html: { class: 'form-label small-text' }, input_html: { class: 'form-control-file' } %>
        </div>
        </div>

        <div class="select-categories">
          <div class="mb-3">
            <%= f.input :category_ids, collection: current_user.categories, as: :check_boxes, label_method: :name, value_method: :id, label: "Select categories", item_wrapper_class: 'form-check-inline', input_html: { class: 'form-check-input custom-checkbox' }, label_html: { class: 'form-check-label small-text' } %>
          </div>
        </div>

        <div class="select-visibility">
          <div class="mb-3">
            <%= f.input :visibility, collection: [['Public', 'public'], ['Private', 'private']], label: "Visibility", as: :radio_buttons, item_wrapper_class: 'form-check-inline', input_html: { class: 'form-check-input custom-visibility-checkbox' }, label_html: { class: 'form-check-label small-text custom-visibility-label' } %>
          </div>
        </div>

        <div class="add-new-recipe text-center">
          <%= f.submit "Add #{@recipe.title}", class: 'btn btn-secondary' %>
        </div>
      <% end %>
      </div>
    </div>
    </div>
      <!--</div>-->
    <!--<div class="mt-3">-->
      <%= link_to recipes_path, class: "btn btn-back" do %>
          <i class="fas fa-light fa-circle-left"></i>
        <% end %>
    <!--</div>-->
  </div>
</div>
