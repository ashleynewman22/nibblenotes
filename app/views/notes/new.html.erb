<div class="notes-new-page">
<div class="add-note-heading">
  <h2>Add a note</h2>
</div>
<hr>

<div class="container new-note-form">
<%= simple_form_for [@recipe, @note] do |f| %>
  <%= f.input :content %>
  <%= f.submit "Add note" %>
  <% end %>

<%= link_to "Back to Recipe", recipe_path(@recipe) %>
</div>
</div>
