<!DOCTYPE html>
<html>
  <head>
    <title>Nibblenotes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'how_it_works', 'data-turbo-track': 'reload' %>
    <%= javascript_include_tag 'animation_homepage', 'data-turbo-track': 'reload' %>
    <%#= javascript_include_tag 'carousel_controller', 'data-turbo-track': 'reload' %>


  </head>

  <body>

    <%= render "shared/navbar" %>
    <%= render "shared/flashes" %>

    <%= yield %>
    <div>
      <%= render "shared/footer" %>
    </div>
  </body>
</html>
